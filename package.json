{
  "name": "torob-mcp-monorepo",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm --filter torob-mcp dev",
    "dev:http": "pnpm --filter torob-mcp dev:http",
    "test": "vitest run",
    "test:live": "TOROB_LIVE=1 vitest run --config vitest.live.config.ts",
    "check": "oxlint . && oxfmt --check && pnpm -r typecheck",
    "check:fix": "oxlint --fix && oxfmt",
    "lint": "oxlint .",
    "fmt": "oxfmt",
    "inspect": "pnpm --filter torob-mcp inspect"
  },
  "devDependencies": {
    "@types/node": "22.10.2",
    "@vitest/coverage-v8": "3.2.4",
    "fast-check": "4.1.1",
    "oxfmt": "0.70.0",
    "oxlint": "1.85.0",
    "tsdown": "0.23.0",
    "typescript": "5.9.3",
    "vitest": "3.2.4"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.19.0"
}
