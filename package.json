{
  "name": "torob-mcp-monorepo",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm --filter torob-mcp dev",
    "dev:http": "pnpm --filter torob-mcp dev:http",
    "test": "pnpm exec vitest run",
    "test:live": "TOROB_LIVE=1 pnpm exec vitest run --config vitest.live.config.ts",
    "check": "pnpm exec oxlint . && pnpm exec oxfmt --check && pnpm -r typecheck",
    "check:fix": "pnpm exec oxlint --fix && pnpm exec oxfmt",
    "lint": "pnpm exec oxlint .",
    "fmt": "pnpm exec oxfmt",
    "inspect": "pnpm --filter torob-mcp inspect",
    "test:coverage": "pnpm exec vitest run --coverage",
    "inspect:cli": "node scripts/inspector-smoke.mjs",
    "inspect:cli:live": "node scripts/inspector-smoke.mjs --live",
    "wiki:publish": "bash scripts/publish-wiki.sh"
  },
  "devDependencies": {
    "@types/node": "22.10.2",
    "@vitest/coverage-v8": "3.2.7",
    "fast-check": "4.1.1",
    "jalaali-js": "1.2.8",
    "oxfmt": "0.70.0",
    "oxlint": "1.85.0",
    "tsdown": "0.23.0",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.19.0"
}
