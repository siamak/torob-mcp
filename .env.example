# torob-mcp configuration. Every value is optional; defaults are shown.
# Validated with zod at startup — a bad value fails fast with a readable message.

# trace | debug | info | warn | error | silent. Queries are logged at debug only, never info.
TOROB_LOG_LEVEL=info

# Sent on every upstream request. Keep it honest and attributable.
# Default: torob-mcp/<version> (+https://github.com/siamak/torob-mcp)
TOROB_USER_AGENT=

# Upstream politeness. Torob publishes no rate limits and returns no 429s, so these are ours
# to honour rather than theirs to enforce.
TOROB_TIMEOUT_MS=10000
TOROB_CONCURRENCY=3
TOROB_RATE_PER_SEC=4

# Cache is in-memory and byte-capped (one product-details response is ~247KB). Nothing is
# written to disk.
TOROB_CACHE_MAX_BYTES=33554432
TOROB_MAX_RESPONSE_BYTES=6291456
TOROB_TTL_SEARCH_S=300
TOROB_TTL_PRODUCT_S=900
TOROB_TTL_PRICE_CHART_S=21600
TOROB_TTL_SHOP_S=21600
TOROB_TTL_CITY_S=86400

# Composite tools (compare_products, get_products_batch) refuse up front rather than failing
# halfway when they would exceed this.
TOROB_MAX_SUBREQUESTS=12

# --- HTTP transport only ---
# Required for any non-loopback bind unless --insecure is passed. Minimum 16 characters.
TOROB_AUTH_TOKEN=
# Comma-separated. Empty means browser requests (any Origin header) are rejected.
TOROB_ALLOWED_ORIGINS=
# Comma-separated. Empty means loopback and the configured bind host only.
TOROB_ALLOWED_HOSTS=
