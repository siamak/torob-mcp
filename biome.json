{
  "$schema": "https://biomejs.dev/schemas/2.5.14/schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": { "includes": ["**", "!**/dist", "!**/coverage", "!fixtures/**"] },
  "formatter": { "indentStyle": "space", "indentWidth": 2, "lineWidth": 100 },
  "javascript": { "formatter": { "quoteStyle": "single", "semicolons": "always" } },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "suspicious": { "noExplicitAny": "error" },
      "complexity": { "noExcessiveCognitiveComplexity": "off" }
    }
  },
  "overrides": [
    {
      "includes": ["packages/core/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "node:fs": "packages/core must stay runtime-agnostic — inject it through Runtime.",
                  "node:path": "packages/core must stay runtime-agnostic — inject it through Runtime.",
                  "node:crypto": "packages/core must stay runtime-agnostic — use crypto.subtle.",
                  "node:buffer": "packages/core must stay runtime-agnostic — use TextEncoder.",
                  "node:process": "packages/core must stay runtime-agnostic — config is injected.",
                  "node:util": "packages/core must stay runtime-agnostic.",
                  "node:stream": "packages/core must stay runtime-agnostic.",
                  "undici": "packages/core uses the global fetch injected through Runtime.",
                  "pino": "packages/core logs through Runtime.log.",
                  "lru-cache": "packages/core caches through Runtime.cache."
                }
              }
            }
          },
          "correctness": {
            "noUndeclaredVariables": "error"
          }
        }
      }
    }
  ]
}
