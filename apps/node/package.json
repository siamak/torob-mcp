{
  "name": "torob-mcp",
  "version": "0.1.0",
  "description": "Unofficial MCP server for torob.com \u2014 Iran's price comparison engine",
  "keywords": [
    "iran",
    "mcp",
    "model-context-protocol",
    "price-comparison",
    "torob"
  ],
  "homepage": "https://github.com/siamak/torob-mcp#readme",
  "bugs": {
    "url": "https://github.com/siamak/torob-mcp/issues"
  },
  "license": "MIT",
  "author": "Siamak Mokhtari",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/siamak/torob-mcp.git",
    "directory": "apps/node"
  },
  "bin": {
    "torob-mcp": "./dist/bin.mjs"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "main": "./dist/bin.mjs",
  "scripts": {
    "build": "tsdown",
    "dev": "node --experimental-strip-types src/bin.ts",
    "dev:http": "node --experimental-strip-types src/bin.ts --http",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "inspect": "npx @modelcontextprotocol/inspector node --experimental-strip-types src/bin.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.1",
    "lru-cache": "11.5.3",
    "pino": "10.3.1",
    "zod": "4.6.5"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@torob-mcp/core": "workspace:*"
  }
}
